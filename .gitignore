# ============================================================
# Python
# ============================================================
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
.eggs/
build/
dist/

# 虚拟环境
.venv/
venv/
env/
ENV/

# 测试 / 类型检查 / 格式化缓存
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# ============================================================
# 打包产物（macOS / Windows / Linux）
# ============================================================
*.app/
*.dmg
*.pkg
*.exe
*.msi
*.AppImage
*.deb
*.rpm

# ============================================================
# 运行时数据
# 正常情况下写到系统数据目录（见 AI_chat/app_paths.py），
# 但数据目录不可写时会回退到当前目录，这里兜底忽略。
# ============================================================
web_history.json
web_conversations.json
chat_history.json
search_cache.json
attachments/
images/
cache/

# 临时目录（LibreOffice 预览、测试导出等）
.dsh-office.*/
.tmp_export/
*.tmp

# ============================================================
# 随包字体（体积大且涉及授权，不入库）
# 需要时按 PLACE_FONTS_HERE.md 自行下载放进该目录
# ============================================================
AI_chat/resources/fonts/*.ttf
AI_chat/resources/fonts/*.otf
AI_chat/resources/fonts/*.ttc
!AI_chat/resources/fonts/PLACE_FONTS_HERE.md

# ============================================================
# 编辑器 / IDE
# ============================================================
.idea/
.vscode/
*.swp
*.swo
*~

# ============================================================
# 操作系统
# ============================================================
.DS_Store
._*
Thumbs.db
desktop.ini

# ============================================================
# 本地配置与日志
# ============================================================
.env
.env.*
*.local
*.log

# ============================================================
# 说明：以下文件**故意不忽略**
#
#   AI_chat.spec                     打包配置，属于源码
#   AI_chat/UI/*.ui                  Qt Designer 源文件
#   AI_chat/UI/main_window.py        pyside6-uic 生成，但运行时必需；
#   AI_chat/UI/modelSelection.py     不提交会导致克隆后直接跑不起来
#   AI_chat/web/vendor/              KaTeX / marked 前端依赖，需随包分发
#
# 修改 .ui 后记得重新生成：
#   cd AI_chat/UI && ../../.venv/bin/pyside6-uic main_window.ui -o main_window.py
# ============================================================
