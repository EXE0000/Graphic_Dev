# ============================================================
# Python
# ============================================================
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
.eggs/
# 单文件打包用 --distpath dist_onefile / --workpath build_onefile，
# 输出目录名和默认的 dist/ build/ 不一样，所以这里用前缀通配。
build*/
dist*/

# 虚拟环境
.venv/
venv/
env/
ENV/

# 测试 / 类型检查 / 格式化缓存
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
pip-wheel-metadata/
*.egg

# ============================================================
# 打包产物（macOS / Windows / Linux）
# ============================================================
*.app/
*.dmg
*.pkg
*.exe
*.msi
*.AppImage
*.deb
*.rpm

# 可选分发格式产物（见 docs/BUILD_WINDOWS_LINUX.md 第 2、7 节）
# pyenv 固定 Python 版本的本地文件
.python-version
# AppImage 更新元数据
*.zsync
# Flatpak 构建缓存与产物
.flatpak-builder/
*.flatpak
# snapcraft 在项目根生成的构建目录（前导 / 根锚定，避免误伤同名源码目录）
/parts/
/prime/
/stage/
*.snap

# ============================================================
# 运行时数据
# 正常情况下写到系统数据目录（见 AI_chat/app_paths.py），
# 但数据目录不可写时会回退到当前目录（也就是项目根），这里兜底忽略。
#
# 目录类规则必须用前导 / 锚定到项目根：不写 / 的话 `images/` 会匹配
# 任意层级的同名目录，把 docs/images/ 这类正经资源静默吞掉——
# 表现是 git status 干干净净、GitHub 上 README 的图全是裂的。
# ============================================================
/web_history.json
/web_conversations.json
/chat_history.json
/search_cache.json
/attachments/
/images/
/cache/

# 临时目录（LibreOffice 预览、测试导出等）
.dsh-office.*/
.tmp_export/
*.tmp

# ============================================================
# 随包字体（体积大且涉及授权，不入库）
# 需要时按 PLACE_FONTS_HERE.md 自行下载放进该目录
# ============================================================
AI_chat/resources/fonts/*.ttf
AI_chat/resources/fonts/*.otf
AI_chat/resources/fonts/*.ttc
!AI_chat/resources/fonts/PLACE_FONTS_HERE.md

# ============================================================
# 编辑器 / IDE
# ============================================================
.idea/
.vscode/
*.swp
*.swo
*~

# ============================================================
# 操作系统
# ============================================================
.DS_Store
._*
.AppleDouble
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# ============================================================
# 本地配置与日志
# ============================================================
.env
.env.*
*.local
*.log

# ============================================================
# 合并 / 备份残留
# 三平台 CI + 多台机器协作时容易留下这类文件，误提交会污染历史
# ============================================================
*.orig
*.rej
*.bak

# ============================================================
# 说明：以下文件**故意不忽略**
#
#   AI_chat.spec                     打包配置，属于源码
#   AI_chat/UI/*.ui                  Qt Designer 源文件
#   AI_chat/UI/main_window.py        pyside6-uic 生成，但运行时必需；
#   AI_chat/UI/modelSelection.py     不提交会导致克隆后直接跑不起来
#   AI_chat/web/vendor/              KaTeX / marked 前端依赖，需随包分发
#   .gitattributes                   换行符策略：跨平台签出必须字节一致，属于源码
#
# 修改 .ui 后记得重新生成：
#   cd AI_chat/UI && ../../.venv/bin/pyside6-uic main_window.ui -o main_window.py
# ============================================================
