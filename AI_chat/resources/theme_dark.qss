/* =========================================================================
   全局主题（QSS）—— 深色
   和 theme.qss 成对维护：结构、选择器完全一致，只换配色。
   @RES@ 在加载时会被替换成 resources 目录的绝对路径（给 image: url() 用）
   配色与 web/css/chat.css 里 [data-theme="dark"] 的那组变量对齐。
   ========================================================================= */

/* ---------- 基础 ---------- */
QWidget {
    color: #e6edf3;
    font-size: 13px;
    font-family: @UIFONT@;
}

QMainWindow, QDialog {
    background: #232830;
}

QToolTip {
    background: #3a424d;
    color: #f2f5f8;
    border: none;
    padding: 4px 8px;
}

/* ---------- 聊天区（WebEngine） ---------- */
QWebEngineView {
    border: 1px solid #333a43;
    border-radius: 10px;
    background: #1c2026;
}

/* ---------- 标签页 ---------- */
QTabWidget::pane {
    border: none;
    background: transparent;
}

QTabBar {
    qproperty-drawBase: 0;
    background: transparent;
}

QTabBar::tab {
    background: transparent;
    color: #9aa4b2;
    padding: 7px 18px;
    margin: 0 2px;
    border-radius: 9px;
    border: none;
}

QTabBar::tab:hover {
    background: #2f3641;
    color: #e6edf3;
}

QTabBar::tab:selected {
    background: #0a84ff;
    color: #ffffff;
}

/* ---------- 按钮 ---------- */
QPushButton {
    background: #2b313a;
    color: #e6edf3;
    border: 1px solid #3a424d;
    border-radius: 8px;
    padding: 6px 14px;
    min-height: 18px;
}

QPushButton:hover {
    background: #343c47;
    border-color: #4a545f;
}

QPushButton:pressed {
    background: #3d4652;
}

QPushButton:disabled {
    background: #262b32;
    color: #6c757f;
    border-color: #303640;
}

/* 主操作：发送。深色下 hover 变亮而不是变暗 */
QPushButton#send_button {
    background: #0a84ff;
    color: #ffffff;
    border: 1px solid #0a84ff;
    font-weight: 600;
}

QPushButton#send_button:hover {
    background: #2c96ff;
    border-color: #2c96ff;
}

QPushButton#send_button:pressed {
    background: #0a63c2;
}

/* 对话框里的主按钮：添加 */
QPushButton#ok_btn {
    background: #0a84ff;
    color: #ffffff;
    border: 1px solid #0a84ff;
    font-weight: 600;
}

QPushButton#ok_btn:hover {
    background: #2c96ff;
    border-color: #2c96ff;
}

/* 表格里的小按钮（删除） */
QTableWidget QPushButton {
    padding: 2px 10px;
    border-radius: 6px;
    min-height: 16px;
}

/* ---------- 输入框 ---------- */
QLineEdit, QPlainTextEdit, QTextEdit {
    background: #2b313a;
    border: 1px solid #3a424d;
    border-radius: 8px;
    padding: 6px 10px;
    selection-background-color: #1e3a5f;
    selection-color: #e6edf3;
}

QLineEdit:focus, QPlainTextEdit:focus, QTextEdit:focus {
    border-color: #3d9bff;
}

QLineEdit:disabled, QPlainTextEdit:disabled, QTextEdit:disabled {
    background: #262b32;
    color: #6c757f;
}

/* ---------- 下拉框 ---------- */
QComboBox {
    background: #2b313a;
    border: 1px solid #3a424d;
    border-radius: 8px;
    padding: 5px 30px 5px 10px;
    min-height: 20px;
}

QComboBox:hover { border-color: #4a545f; }
QComboBox:focus { border-color: #3d9bff; }

QComboBox::drop-down {
    border: none;
    width: 26px;
}

QComboBox::down-arrow {
    image: url("@RES@/chevron-down-dark.svg");
    width: 10px;
    height: 10px;
}

QComboBox QAbstractItemView {
    background: #2b313a;
    border: 1px solid #3a424d;
    border-radius: 8px;
    padding: 4px;
    outline: 0;
    selection-background-color: #1e3a5f;
    selection-color: #e6edf3;
}

/* ---------- 复选框 ---------- */
QCheckBox {
    spacing: 8px;
    color: #e6edf3;
    background: transparent;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #5b6673;
    border-radius: 5px;
    background: #2b313a;
}

QCheckBox::indicator:hover {
    border-color: #3d9bff;
}

QCheckBox::indicator:checked {
    background: #0a84ff;
    border-color: #0a84ff;
    image: url("@RES@/check.svg");
}

QCheckBox::indicator:disabled {
    background: #262b32;
    border-color: #333a43;
}

/* ---------- 表格 ---------- */
QTableWidget {
    background: #2b313a;
    border: 1px solid #333a43;
    border-radius: 10px;
    gridline-color: transparent;
    alternate-background-color: #262c34;
    selection-background-color: #1e3a5f;
    selection-color: #e6edf3;
}

QHeaderView::section {
    background: #262c34;
    color: #9aa4b2;
    border: none;
    border-bottom: 1px solid #333a43;
    padding: 7px 10px;
    font-weight: 600;
}

QTableCornerButton::section {
    background: #262c34;
    border: none;
}

QTableView::indicator, QListView::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #5b6673;
    border-radius: 5px;
    background: #2b313a;
}

QTableView::indicator:checked, QListView::indicator:checked {
    background: #0a84ff;
    border-color: #0a84ff;
    image: url("@RES@/check.svg");
}

/* ---------- 滚动条 ---------- */
QScrollBar:vertical {
    background: transparent;
    width: 12px;
    margin: 3px;
}

QScrollBar::handle:vertical {
    background: #4a545f;
    border-radius: 5px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover { background: #5b6673; }

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    height: 0;
    background: transparent;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 2px;
}

QScrollBar::handle:horizontal {
    background: #4a545f;
    border-radius: 5px;
    min-width: 30px;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal,
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    width: 0;
    background: transparent;
}

/* ---------- 状态栏 ---------- */
QStatusBar {
    background: #232830;
    border-top: 1px solid #333a43;
    color: #9aa4b2;
}

QStatusBar::item { border: none; }

/* ---------- 列表 ---------- */
QListWidget {
    background: #2b313a;
    border: 1px solid #333a43;
    border-radius: 10px;
    outline: 0;
}

QListWidget::item {
    padding: 4px 8px;
    border-radius: 6px;
}

QListWidget::item:hover {
    background: #343c47;
}

QListWidget::item:selected {
    background: #1e3a5f;
    color: #e6edf3;
}

/* ---------- 滚动区域 ---------- */
/* 配置页和个性化页都包在 QScrollArea 里。这里不写背景的话，视口会跟着
   系统配色走——深色模式下就是黑底配上面的黑字，整页直接看不见。 */
QScrollArea {
    background: #232830;
    border: none;
}

QScrollArea > QWidget > QWidget {
    background: transparent;
}

/* ---------- 右键菜单 ---------- */
/* 输入框的撤销/粘贴菜单同理：不设 QSS 就走原生深色，和上面的黑字撞车。 */
QMenu {
    background: #2b313a;
    border: 1px solid #3a424d;
    border-radius: 8px;
    padding: 4px;
}

QMenu::item {
    padding: 5px 22px 5px 12px;
    border-radius: 6px;
}

QMenu::item:selected {
    background: #1e3a5f;
    color: #e6edf3;
}

QMenu::item:disabled {
    color: #6c757f;
}

QMenu::separator {
    height: 1px;
    background: #333a43;
    margin: 4px 6px;
}

QMenu::indicator {
    width: 14px;
    height: 14px;
}

/* ---------- 按 objectName 定制的几处 ---------- */
/* 模型选择弹窗的列表（原来这段写死在 model_dialog.py 里） */
QListWidget#model_list::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #5b6673;
    border-radius: 4px;
    background: #2b313a;
}

QListWidget#model_list::indicator:checked {
    background: #0a84ff;
    border-color: #0a84ff;
    image: url("@RES@/check.svg");
}

QListWidget#model_list::item {
    padding-left: 8px;
    padding-top: 2px;
    padding-bottom: 2px;
}

/* 模型列表为空时的提示文字 */
QLabel#empty_label {
    color: #9aa4b2;
    font-size: 12px;
}

/* 待发送附件的 chip，点一下移除（原来写死在 app.py 里） */
QPushButton#attach_chip {
    border: 1px solid #3a424d;
    border-radius: 10px;
    padding: 2px 10px;
    background: #262c34;
    font-size: 12px;
    color: #e6edf3;
}

QPushButton#attach_chip:hover {
    background: #3b1d20;
    border-color: #6e2b2f;
    color: #ff7b72;
}
